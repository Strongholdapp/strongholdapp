          "userTrackingPermission": "We use this to show you more relevant ads and measure how our ads are performing."
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1596500312114145",
          "clientToken": "f2abb3bc6d528ba5964f37aefb01400e",
          "displayName": "Stronghold",
          "scheme": "fb1596500312114145",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": true
        }
      ]
    ]
  }
