# ============================================================
# Copie este arquivo para .env (o .env NÃO vai pro Git).
# No Codemagic, crie as mesmas variáveis no grupo "stronghold".
#
# Tudo aqui é client-side por natureza (anon key do Supabase e public key
# do Superwall). NUNCA coloque a service_role key do Supabase aqui.
# ============================================================

# --- Supabase (Lucas já entregou) ---
EXPO_PUBLIC_SUPABASE_URL=https://eivbtkcmifznjsirjhfr.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Superwall (falta o Lucas mandar) ---
EXPO_PUBLIC_SUPERWALL_API_KEY=
EXPO_PUBLIC_SUPERWALL_PLACEMENT=unlock_stronghold

# --- Paywall ---
# false = o app roda inteiro sem cobrar (útil pra gravar anúncio e testar).
EXPO_PUBLIC_PAYWALL_ENABLED=true
